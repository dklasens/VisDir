<Window x:Class="VisDir.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sb="clr-namespace:VisDir.App.Sunburst" xmlns:local="clr-namespace:VisDir.App"
        Title="VisDir" Width="1180" Height="780" MinWidth="960" MinHeight="620" WindowStartupLocation="CenterScreen" ShowInTaskbar="True"
        Background="#222638" Foreground="#F4F5F9" PreviewKeyDown="OnWindowKeyDown" AllowDrop="True" Drop="OnWindowDrop" DragOver="OnWindowDragOver">
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBgBrush" Color="#222638"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#1D202E"/>
        <SolidColorBrush x:Key="CardBrush" Color="#282D40"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#343B52"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F4F5F9"/>
        <SolidColorBrush x:Key="DimBrush" Color="#8E95AA"/>
        <SolidColorBrush x:Key="AccentGreenBrush" Color="#5CD68D"/>
        <SolidColorBrush x:Key="AccentBlueBrush" Color="#4E75DB"/>
        <SolidColorBrush x:Key="DeleteRedBrush" Color="#B33942"/>
        <SolidColorBrush x:Key="DockBgBrush" Color="#181B27"/>
        <DropShadowEffect x:Key="PopupShadow" BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.5" Color="#000000"/>
        <DropShadowEffect x:Key="ModalShadow" BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.65" Color="#000000"/>
        
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F4F5F9"/></Style>
        <Style x:Key="Dim" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource DimBrush}"/></Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource Dim}"><Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
        
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBlueBrush}"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.88"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.38"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        
        <Style x:Key="DeleteButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="{StaticResource DeleteRedBrush}"/>
            <Setter Property="Padding" Value="16,8"/>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#2C3347"/><Setter Property="Padding" Value="11,7"/><Setter Property="Foreground" Value="#E0E4F0"/>
        </Style>
        
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="#2A3147"/><Setter Property="Foreground" Value="#BAC1D4"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="28"/><Setter Property="Height" Value="28"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="NavChrome" Background="{TemplateBinding Background}" CornerRadius="6"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavChrome" Property="Background" Value="#384362"/><Setter Property="Foreground" Value="White"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="NavChrome" Property="Opacity" Value="0.3"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="BreadcrumbRootButton" TargetType="Button">
            <Setter Property="Background" Value="#313B59"/><Setter Property="Foreground" Value="#E2E6F2"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,5"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="12"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="RootChrome" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RootChrome" Property="Background" Value="#3E4A70"/><Setter Property="Foreground" Value="White"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="BreadcrumbButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#B8BFD4"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="6,3"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="BreadcrumbChrome" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="BreadcrumbChrome" Property="Background" Value="#2E3650"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="White"/><Setter Property="Cursor" Value="Arrow"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="#8E95AA"/>
            <Setter Property="Padding" Value="6,4"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="White"/><Setter TargetName="Chrome" Property="Background" Value="#333C56"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style TargetType="GridSplitter">
            <Setter Property="Background" Value="Transparent"/><Setter Property="Width" Value="6"/><Setter Property="Cursor" Value="SizeWE"/><Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GridSplitter">
                <Border x:Name="Grip" Background="Transparent"/>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="#305CD68D"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#252A3D"/><Setter Property="Foreground" Value="#F4F5F9"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="Padding" Value="9,6"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
                <Grid>
                    <ToggleButton x:Name="Toggle" Focusable="False" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                  IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource AncestorType=ComboBox}, Mode=TwoWay}">
                        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="ComboChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"><Path Data="M 0 0 L 4.5 4.5 L 9 0" Stroke="#AEB2BD" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboChrome" Property="Background" Value="#2D3349"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
                    </ToggleButton>
                    <ContentPresenter IsHitTestVisible="False" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Left"
                                      Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                    <Popup x:Name="PART_Popup" Placement="Bottom" PlacementTarget="{Binding ElementName=Toggle}" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False">
                        <Grid Margin="0,3,12,14" Background="Transparent">
                            <Border Width="{Binding ActualWidth, ElementName=Toggle}" Background="#252A3D" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Effect="{StaticResource PopupShadow}">
                                <ScrollViewer MaxHeight="320" Margin="4"><ItemsPresenter/></ScrollViewer>
                            </Border>
                        </Grid>
                    </Popup>
                </Grid>
                <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#F4F5F9"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="9,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ComboItem" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ComboItem" Property="Background" Value="#38405A"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ComboItem" Property="Background" Value="#313B59"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="TextBox"><Setter Property="Background" Value="#202436"/><Setter Property="Foreground" Value="#F4F5F9"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="CaretBrush" Value="White"/><Setter Property="Padding" Value="9,7"/></Style>
        
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,2"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#2D3349"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#353E5C"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
            <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnListBoxItemPreviewMouseRightButtonDown"/>
        </Style>

        <!-- Dark DaisyDisk ContextMenu, MenuItem & Separator Styles -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="#222638"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}" Effect="{StaticResource PopupShadow}">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F4F5F9"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="MenuBorder" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="Icon" Content="{TemplateBinding Icon}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <ContentPresenter Grid.Column="1" Content="{TemplateBinding Header}" RecognizesAccessKey="True" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Foreground="{StaticResource DimBrush}" Margin="16,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="MenuBorder" Property="Background" Value="#353E5C"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#656C82"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Separator">
            <Setter Property="Background" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="4,3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Background="{TemplateBinding Background}" Height="{TemplateBinding Height}" Margin="{TemplateBinding Margin}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOP NAVIGATION BAR (DAISYDISK STYLE) -->
        <Border Grid.Row="0" Background="#1D202E" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,0">
            <DockPanel LastChildFill="True">
                <!-- Left: History Navigation Buttons (< and >) -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <Button x:Name="BackButton" Style="{StaticResource NavButton}" Content="‹" FontSize="18" Margin="0,0,4,0" ToolTip="Go back (Alt+Left / Backspace)" Click="OnBackClick" IsEnabled="False"/>
                    <Button x:Name="ForwardButton" Style="{StaticResource NavButton}" Content="›" FontSize="18" ToolTip="Go forward (Alt+Right)" Click="OnForwardClick" IsEnabled="False"/>
                </StackPanel>

                <!-- Right: Update Notification, Rescan, Engine pill -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="UpdateBadgeButton" Style="{StaticResource SecondaryButton}" 
                            Visibility="Collapsed" 
                            Background="#1C3829" BorderBrush="#48B372" Foreground="#8CE9AC"
                            Padding="8,4" Margin="0,0,10,0" FontSize="11" FontWeight="SemiBold"
                            Click="OnUpdateBadgeClick" ToolTip="Click to view update details and install">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="✦ " FontSize="11" Foreground="#5CD68D"/>
                            <TextBlock x:Name="UpdateBadgeText" Text="Update available"/>
                        </StackPanel>
                    </Button>
                    <Border x:Name="EngineBadge" Visibility="Collapsed" Background="#2E3752" CornerRadius="5" Padding="8,4" Margin="0,0,10,0">
                        <TextBlock x:Name="EngineBadgeText" FontSize="11" FontWeight="SemiBold" Foreground="#B0BCDE" Text="FAST NTFS"/>
                    </Border>
                    <Button x:Name="RescanButton" Style="{StaticResource SecondaryButton}" Content="↻ Rescan" FontSize="11" Padding="10,5" Margin="0,0,0,0" ToolTip="Rescan current folder (F5)" Click="OnRescanClick" Visibility="Collapsed"/>
                </StackPanel>

                <!-- Center: Breadcrumbs starting with "Disks and Folders" -->
                <ScrollViewer VerticalAlignment="Center" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="DisksRootButton" Style="{StaticResource BreadcrumbRootButton}" Content="Disks and Folders" Click="OnDisksRootClick" ToolTip="Return to all drives overview"/>
                        <StackPanel x:Name="BreadcrumbBar" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- MAIN CONTENT AREA -->
        <Grid Grid.Row="1">
            <!-- 1. LANDING VIEW: DISKS AND FOLDERS OVERVIEW -->
            <Grid x:Name="LandingPanel" Margin="36,24,36,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                    <TextBlock Text="Disks and Folders" FontSize="26" FontWeight="Bold"/>
                    <TextBlock Style="{StaticResource Dim}" FontSize="13.5" Margin="0,4,0,0" Text="Select a disk or folder to scan, or drag and drop any folder here."/>
                </StackPanel>

                <!-- Drive Cards Grid Area -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ListBox x:Name="DriveCards" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             SelectionChanged="OnDriveCardSelected" MouseDoubleClick="OnDriveCardDoubleClick">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="Width" Value="340"/>
                                <Setter Property="Margin" Value="0,0,16,16"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="ToolTip" Value="Double-click to scan this drive"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="💽" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" Foreground="White" FontSize="14.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding CapacityText}" Style="{StaticResource Dim}" FontSize="11" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="Scan" FontSize="12" Padding="14,6" Click="OnDriveCardScanClick" Tag="{Binding}"/>
                                        </Grid>
                                        
                                        <!-- Capacity Bar Gauge -->
                                        <ProgressBar Height="6" Minimum="0" Maximum="1" Value="{Binding UsedFraction, Mode=OneWay}" Background="#384058" Foreground="{StaticResource AccentGreenBrush}" BorderThickness="0"/>
                                        
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding FreeText}" Style="{StaticResource Dim}" FontSize="11"/>
                                            <TextBlock Grid.Column="1" Text="{Binding UsedPercentText}" Foreground="#C5CDDF" FontSize="11" FontWeight="SemiBold"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>

                <!-- Bottom Landing Toolbar / Drop Zone -->
                <Border Grid.Row="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource SecondaryButton}" Content="📂 Choose a Folder…" FontSize="12" Padding="14,8" Click="OnBrowseFolderClick"/>
                            <Button Style="{StaticResource GhostButton}" Content="Check for Updates" FontSize="11.5" Padding="10,6" Margin="10,0,0,0" Click="OnManualCheckUpdatesClick"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Style="{StaticResource Dim}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" Text="Or drop any folder here from Explorer to start scanning immediately"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource SectionLabel}" Text="ENGINE:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="LandingScanModeBox" Width="170" Height="32" SelectedIndex="0">
                                <ComboBoxItem Content="Automatic" Tag="auto"/>
                                <ComboBoxItem Content="Fast NTFS (Admin)" Tag="mft"/>
                                <ComboBoxItem Content="Compatible" Tag="generic"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- 2. DETAIL VIEW: SUNBURST (LEFT) + DAISYDISK INSPECTOR LIST (RIGHT) -->
            <Grid x:Name="ContentShell" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6*" MinWidth="420"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="4*" MinWidth="300"/>
                </Grid.ColumnDefinitions>

                <!-- Left Column: Sunburst Chart -->
                <Grid Grid.Column="0">
                    <sb:SunburstControl x:Name="Burst" Focusable="True" ContextMenuOpening="OnBurstContextMenuOpening">
                        <sb:SunburstControl.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="📂  Reveal in File Explorer" Click="OnRevealSunburstContextClick"/>
                                <Separator/>
                                <MenuItem Header="📋  Copy Full Path" Click="OnCopyPathSunburstContextClick"/>
                            </ContextMenu>
                        </sb:SunburstControl.ContextMenu>
                    </sb:SunburstControl>

                    <!-- Scanning Overlay -->
                    <Grid x:Name="ScanOverlay" Background="#EA222638" Visibility="Collapsed">
                        <Border Background="#282D42" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="28,24" HorizontalAlignment="Center" VerticalAlignment="Center" Effect="{StaticResource PopupShadow}" MinWidth="320">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Scanning Target…" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="ScanOverlayTarget" Style="{StaticResource Dim}" FontSize="12" Margin="0,6,0,16" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="280"/>
                                <ProgressBar x:Name="ScanProgressBar" Width="260" Height="4" Margin="0,0,0,12" Background="#384058" Foreground="{StaticResource AccentGreenBrush}" BorderThickness="0" IsIndeterminate="True"/>
                                <TextBlock x:Name="ScanPhaseText" Style="{StaticResource Dim}" FontSize="11.5" HorizontalAlignment="Center" Margin="0,0,0,18" Text="Reading directory structure…"/>
                                <Button Style="{StaticResource SecondaryButton}" Content="Cancel Scan" Padding="14,6" FontSize="11.5" HorizontalAlignment="Center" Click="OnCancelScanClick"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <GridSplitter Grid.Column="1"/>

                <!-- Right Column: DaisyDisk-style Contents List / Inspector -->
                <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                    <Grid Margin="18,14">
                        <Grid.RowDefinitions>
                            <!-- 0: Active Folder Header -->
                            <RowDefinition Height="Auto"/>
                            <!-- 1: Filter / Search Box -->
                            <RowDefinition Height="Auto"/>
                            <!-- 2: File/Folder Items List -->
                            <RowDefinition Height="*"/>
                            <!-- 3: Selected Item Info Footer -->
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header Row (Matches DaisyDisk in image.png) -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="CurrentFolderDot" Width="10" Height="10" CornerRadius="5" Background="{StaticResource AccentGreenBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock x:Name="CurrentFolderName" Grid.Column="1" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Text="Folder"/>
                            <TextBlock x:Name="CurrentFolderTotalSize" Grid.Column="2" FontSize="16" FontWeight="SemiBold" Foreground="#F4F5F9" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </Grid>

                        <!-- Search Filter -->
                        <Grid Grid.Row="1" Margin="0,0,0,10">
                            <TextBox x:Name="SearchBox" TextChanged="OnSearchChanged" AutomationProperties.Name="Filter contents" Padding="8,6" Background="#252A3D" BorderBrush="{StaticResource BorderBrush}"/>
                            <TextBlock x:Name="SearchPlaceholder" Text="Filter this folder…" IsHitTestVisible="False" Foreground="#6C7286" FontSize="11.5" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            <Button x:Name="ClearSearchButton" Style="{StaticResource GhostButton}" Content="✕" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" Padding="4,2" FontSize="10" Visibility="Collapsed" Click="OnClearSearchClick"/>
                        </Grid>

                        <!-- Contents List (Virtualized ListBox with DaisyDisk-style items) -->
                        <Grid Grid.Row="2">
                            <ListBox x:Name="ChildrenList" Background="Transparent" BorderThickness="0" SelectionChanged="OnChildSelected" MouseDoubleClick="OnChildDoubleClick" KeyDown="OnChildrenKeyDown" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="📂  Reveal in File Explorer" Click="OnRevealContextClick"/>
                                        <Separator/>
                                        <MenuItem Header="📋  Copy Full Path" Click="OnCopyPathContextClick"/>
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="6,5" ToolTip="{Binding ToolTipText}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            
                                            <!-- Item Row: Dot + Name + Right-Aligned Size -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="16"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="8" Height="8" CornerRadius="4" Background="{Binding ChipBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="12.5" Foreground="{Binding TextBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="2,0,0,0"/>
                                                <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="12" Foreground="{Binding SizeBrush}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,4,0"/>
                                            </Grid>

                                            <!-- Subtle Proportional Bar Gauge -->
                                            <ProgressBar Grid.Row="1" Height="2.5" Margin="18,4,4,1" Minimum="0" Maximum="1" Value="{Binding BarFraction, Mode=OneWay}" Foreground="{Binding ChipBrush}" Background="#262B3D" BorderThickness="0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            
                            <TextBlock x:Name="EmptyListText" Style="{StaticResource Dim}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,0" IsHitTestVisible="False" Visibility="Collapsed"/>
                        </Grid>

                        <!-- Selected Item Status / Path Info -->
                        <Border x:Name="SelectedInfoBorder" Grid.Row="3" Background="#252A3D" CornerRadius="6" Padding="10,8" Margin="0,10,0,0" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="SelectedNodeMeta" Style="{StaticResource Dim}" FontSize="10.5"/>
                                    <TextBlock x:Name="SelectedPathText" Style="{StaticResource Dim}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="📂" ToolTip="Open in File Explorer" VerticalAlignment="Center" Margin="6,0,0,0" Click="OnRevealSelectedClick"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- 3. UPDATE MODAL OVERLAY -->
            <Grid x:Name="UpdateOverlay" Background="#EA1D202E" Visibility="Collapsed">
                <Border Background="#252A3D" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="28,24" HorizontalAlignment="Center" VerticalAlignment="Center" Effect="{StaticResource PopupShadow}" MinWidth="440" MaxWidth="520">
                    <StackPanel>
                        <DockPanel LastChildFill="True" Margin="0,0,0,14">
                            <Button DockPanel.Dock="Right" Style="{StaticResource NavButton}" Content="✕" FontSize="14" Width="28" Height="28" Click="OnCloseUpdateOverlayClick" ToolTip="Close"/>
                            <StackPanel>
                                <TextBlock x:Name="UpdateTitleText" Text="Update Available" FontSize="18" FontWeight="Bold"/>
                                <TextBlock x:Name="UpdateVersionSubtitle" Style="{StaticResource Dim}" FontSize="12.5" Margin="0,2,0,0" Text="A new version of VisDir is ready to install"/>
                            </StackPanel>
                        </DockPanel>

                        <TextBlock Style="{StaticResource SectionLabel}" Text="RELEASE NOTES" Margin="0,0,0,6"/>
                        <Border Background="#1C2030" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Height="140" Margin="0,0,0,16">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="UpdateNotesText" Style="{StaticResource Dim}" FontSize="12" TextWrapping="Wrap"/>
                            </ScrollViewer>
                        </Border>

                        <!-- Download Progress Bar -->
                        <StackPanel x:Name="UpdateProgressPanel" Visibility="Collapsed" Margin="0,0,0,16">
                            <ProgressBar x:Name="UpdateProgressBar" Height="6" Minimum="0" Maximum="1" Background="#384058" Foreground="{StaticResource AccentGreenBrush}" BorderThickness="0" Margin="0,0,0,8"/>
                            <TextBlock x:Name="UpdateProgressText" Style="{StaticResource Dim}" FontSize="11.5" HorizontalAlignment="Center" Text="Downloading: 0%"/>
                        </StackPanel>

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource SecondaryButton}" Content="View on GitHub" FontSize="11.5" Padding="12,7" Click="OnViewUpdateGitHubClick"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button x:Name="UpdateCancelButton" Style="{StaticResource SecondaryButton}" Content="Later" FontSize="11.5" Padding="14,7" Margin="0,0,8,0" Click="OnCloseUpdateOverlayClick"/>
                                <Button x:Name="UpdateActionButton" Style="{StaticResource PrimaryButton}" Content="Download &amp; Install" FontSize="12" Padding="16,7" Click="OnUpdateActionClick"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
